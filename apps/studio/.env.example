# ===========================================
# STUDIO ENVIRONMENT VARIABLES
# ===========================================
# Copy to `.env` and fill in. Vite loads `.env*` from this directory.
#
# Everything the Studio bundle reads must use the SANITY_STUDIO_ prefix — Vite
# strips anything else out. That is why the project ID appears here as well as
# in apps/web/.env.local: same value, two prefixes, two consumers.

# --- Required ---
SANITY_STUDIO_PROJECT_ID=your-project-id

# NOTE: there is no SANITY_STUDIO_DATASET for the Studio itself. Datasets are
# declared per workspace in sanity.config.ts, and you switch between them with
# the workspace dropdown in the navbar. The variable below only sets the
# default target for Sanity CLI commands (dataset export, migration run,
# schema deploy); it defaults to `develop` when unset.
# SANITY_STUDIO_DATASET=develop

# --- Presentation / visual editing ---
# Preview target for the `develop` workspace
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
# Preview target for the `prod` workspace — points at the live site so prod
# content is previewed against prod. Falls back to the value above when unset.
SANITY_STUDIO_PREVIEW_URL_PROD=https://your-domain.com
# Must match SANITY_STUDIO_PREVIEW_SECRET in apps/web
SANITY_STUDIO_PREVIEW_SECRET=your-preview-secret

# --- Deployment (optional) ---
SANITY_STUDIO_HOST=your-studio-host

# --- Dashboard widgets (optional) ---
SANITY_STUDIO_VERCEL_PROJECT_URL=https://vercel.com/your-team/your-project
SANITY_STUDIO_REPO_URL=https://github.com/your-org/your-repo
SANITY_STUDIO_MANAGE_URL=https://www.sanity.io/manage
SANITY_STUDIO_PLAYBOOK_URL=

# Google Search Console widget — read-only service account credentials
SANITY_STUDIO_GSC_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON key file; use literal \n for newlines
SANITY_STUDIO_GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# Exact property URL registered in Search Console (trailing slash for URL-prefix properties)
SANITY_STUDIO_GSC_SITE_URL=https://your-domain.com/

# --- Syndication ---
# Medium is copy-paste only (API retired) — no key needed here.
# Dev.to syndication runs as a Sanity Function server-side.
# Set DEVTO_KEY via: sanity functions env add syndicate-devto DEVTO_KEY <key>
# (see functions/README.md)
