{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [],
  "globalEnv": [],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "ALLOW_CRAWLERS",
        "NEXT_PUBLIC_CONTACT_EMAIL",
        "NEXT_PUBLIC_RECAPTCHA_SITE_KEY",
        "RECAPTCHA_SECRET_KEY",
        "MAIL_APP_ENDPOINT",
        "SUBMISSION_SECRET",
        "SITE_URL",
        "SANITY_PROJECT_ID",
        "SANITY_DATASET",
        "SANITY_API_READ_TOKEN",
        "SANITY_REVALIDATE_SECRET",
        "SANITY_STUDIO_URL",
        "SANITY_STUDIO_PREVIEW_SECRET",
        "NEXT_PUBLIC_GTM_ID"
      ]
    },
    "studio#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "SANITY_STUDIO_PROJECT_ID",
        "SANITY_STUDIO_DATASET",
        "SANITY_STUDIO_PREVIEW_URL",
        "SANITY_STUDIO_PREVIEW_URL_PROD",
        "SANITY_STUDIO_PREVIEW_SECRET",
        "SANITY_STUDIO_URL",
        "SANITY_STUDIO_HOST",
        "SANITY_STUDIO_GSC_SERVICE_ACCOUNT_EMAIL",
        "SANITY_STUDIO_GSC_PRIVATE_KEY",
        "SANITY_STUDIO_GSC_SITE_URL",
        "SANITY_STUDIO_VERCEL_PROJECT_URL",
        "SANITY_STUDIO_REPO_URL",
        "SANITY_STUDIO_MANAGE_URL",
        "SANITY_STUDIO_PLAYBOOK_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["SANITY_DATASET"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
